{"type":"request-a-review","version":"1.0.0","sections":{"p--ask-for-a-review":{"l10n":{"vars":{"lng":"en","ns":"p-ask-for-review"},"translations":[{"language":"en","namespace":"p-ask-for-review","resources":{"out-of-time-warning":{"description":{"expired":"<div role=\"region\" class=\"moj-alert moj-alert--information\" aria-label=\"You missed your deadline to ask for a review but can still request one\" data-module=\"moj-alert\" data-dismissible=\"false\">\n                                <div>\n                                    <svg class=\"moj-alert__icon\" role=\"presentation\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 30 30\" height=\"30\" width=\"30\">\n                                    <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M10.2165 3.45151C11.733 2.82332 13.3585 2.5 15 2.5C16.6415 2.5 18.267 2.82332 19.7835 3.45151C21.3001 4.07969 22.6781 5.00043 23.8388 6.16117C24.9996 7.3219 25.9203 8.69989 26.5485 10.2165C27.1767 11.733 27.5 13.3585 27.5 15C27.5 18.3152 26.183 21.4946 23.8388 23.8388C21.4946 26.183 18.3152 27.5 15 27.5C13.3585 27.5 11.733 27.1767 10.2165 26.5485C8.69989 25.9203 7.3219 24.9996 6.16117 23.8388C3.81696 21.4946 2.5 18.3152 2.5 15C2.5 11.6848 3.81696 8.50537 6.16117 6.16117C7.3219 5.00043 8.69989 4.07969 10.2165 3.45151ZM16.3574 22.4121H13.6621V12.95H16.3574V22.4121ZM13.3789 9.20898C13.3789 8.98763 13.4212 8.7793 13.5059 8.58398C13.5905 8.38216 13.7044 8.20964 13.8477 8.06641C13.9974 7.91667 14.1699 7.79948 14.3652 7.71484C14.5605 7.63021 14.7721 7.58789 15 7.58789C15.2214 7.58789 15.4297 7.63021 15.625 7.71484C15.8268 7.79948 15.9993 7.91667 16.1426 8.06641C16.2923 8.20964 16.4095 8.38216 16.4941 8.58398C16.5788 8.7793 16.6211 8.98763 16.6211 9.20898C16.6211 9.43685 16.5788 9.64844 16.4941 9.84375C16.4095 10.0391 16.2923 10.2116 16.1426 10.3613C15.9993 10.5046 15.8268 10.6185 15.625 10.7031C15.4297 10.7878 15.2214 10.8301 15 10.8301C14.7721 10.8301 14.5605 10.7878 14.3652 10.7031C14.1699 10.6185 13.9974 10.5046 13.8477 10.3613C13.7044 10.2116 13.5905 10.0391 13.5059 9.84375C13.4212 9.64844 13.3789 9.43685 13.3789 9.20898Z\" fill=\"currentColor\" />\n                                    </svg>\n                                </div>\n                                <div class=\"moj-alert__content\">\n                                    <h2 class=\"moj-alert__heading\">You missed you're deadline to ask for a review</h2>\n                                    You can still ask for one, but we'll need to know why your request is late.</div>\n                                </div>","inTime":"<p hidden></p>"}}}}]},"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,"properties":{"ask-for-a-review":{"title":"What we'll ask you","description":"\n                        <p class=\"govuk-body\">We need to find out more about why you would like us to review our decision about your claim.</p>\n                        <p class=\"govuk-body\">To do this we'll ask for your reasons for wanting a review. We'll also ask if you have any supporting information to send us.</p>\n                        "},"out-of-time-warning":{"description":["|l10nt",["|role.all","expired"],"out-of-time-warning.description.expired",["|role.all","inTime"],"out-of-time-warning.description.inTime"]}},"meta":{"pageType":"context"},"options":{"outputOrder":["out-of-time-warning","ask-for-a-review"],"showSurvey":"beta","transformOrder":["out-of-time-warning","ask-for-a-review"]}}},"p--decision":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,"properties":{"context-decison-letter":{"title":"Decision about your application for compensation","description":"\n                    <p class=\"govuk-body govuk-!-margin-bottom-0\">{{{ applicantForename }}} {{{ applicantSurname }}}</p>\n                    <p class=\"govuk-body govuk-!-margin-bottom-0\">Reference number: {{{ caseReferenceNumber }}}</p>\n                    <p class=\"govuk-body\">{{{ dateSent }}}</p>\n                    <p class=\"govuk-body\">Thank you for your application for criminal injuries compensation.</p>\n                    <p class=\"govuk-body\"><b>Unfortunately, you are not eligible for compensation.</b></p>\n                    <p class=\"govuk-body\">We are sorry about the experience that led you to apply for compensation. We understand this decision may be upsetting.</p>\n                    <h2 class=\"govuk-heading-m\">What you should do</h2>\n                    <ol class='govuk-list govuk-list--number'>\n                    <li>Read the explanation about why you are not eligible.</li>\n                    <li>Decide if you agree with the decision or not</li>\n                    <li>If you do <b>not</b> agree with the decision, read about how to ask for a review</li>\n                    </ol>\n                    <h2 class=\"govuk-heading-m\">Why you are not eligible</h2>\n                    <p class=\"govuk-body\">To work out if you're eligible for compensation, a claims officer followed the rules in the <a href=\"https://assets.publishing.service.gov.uk/media/5d00c89ee5274a3cfa8a4ffe/criminal-injuries-compensation-scheme-2012.pdf\" target=\"_blank\" class=\"govuk-link\">Criminal Injuries Compensation Scheme (opens in a new tab).<a></p>\n                    <p class=\"govuk-body\"><b>This is what the claims officer says about your claim</b></p>\n                    <p class=\"govuk-body\">{{{ shortExplanation }}}</p>\n                    <h3 class=\"govuk-heading-s\">Scheme rules which have affected your eligibility to receive an award</h3>\n                    <p class=\"govuk-body\">These specific rules in the Scheme apply to this decision.</p>\n                    <p class=\"govuk-body\">{{{ paragraph1 }}}</p>\n                    {{{ if paragraph2 }}}\n                    <p class=\"govuk-body\">{{{ paragraph2 }}}</p>\n                    {{{ endif }}}\n                    {{{ if paragraph3 }}}\n                    <p class=\"govuk-body\">{{{ paragraph3 }}}</p>\n                    {{{ endif }}}\n                    <h2 class=\"govuk-heading-m\">What to do next</h2>\n                    <p class=\"govuk-body\">You should now decide if you accept this decision or not.</p>\n                    <p class=\"govuk-body\">If you accept this decision, you do not need to do anything.</p>\n                    <h2 class=\"govuk-heading-m\">Ask for a review</h2>\n                    <p class=\"govuk-body\">You may want to ask for a review if you:</p>\n                    <ul class='govuk-list govuk-list--bullet'>\n                    <li>do not think we've considered all the information you gave us</li>\n                    <li>think we've looked at the wrong information</li>\n                    <li>have any extra information you'd like to give us</li>\n                    <li>think our decision was wrong for another reason</li>\n                    </ul>\n                    <p class=\"govuk-body\">The deadline for asking for a review is <b>11:59pm on {{{ requestReviewBy }}}.</b></p>\n                    <p class=\"govuk-body\">We may be able to extend this date if there are exceptional circumstances.We can only extend the time limit once. Email or write to us if you need an extension to this date.</p>\n                    <p class=\"govuk-body\">You can ask for a review yourself. You do not need to pay someone to do this for you. If you choose to pay a legal representative, we cannot pay their fees.</p>\n                    <h3 class=\"govuk-heading-s\">What happens when you ask for a review</h3>\n                    <p class=\"govuk-body\">A different claims officer will make a new decision about your claim.</p>\n                    <p class=\"govuk-body\">We make most review decisions within 6 months. Sometimes it can take longer depending on the circumstances of your claim.</p>\n                    <p class=\"govuk-body\">If you do not agree with the review decision, you can appeal to a tribunal.</p>\n                    <button type=\"submit\" data-prevent-double-click=\"true\" class=\"govuk-button govuk-button--start\">Ask for a review</button>\n                    <article class=\"moj-ticket-panel\" aria-label=\"Sub navigation 1\">\n                    <section class=\"moj-ticket-panel__content moj-ticket-panel__content--blue\" aria-label=\"Section 1\">\n                        <h2 class=\"govuk-heading-l govuk-!-margin-bottom-4\">Save this decision</h2>\n                        <p class=\"govuk-body\"><a class=\"govuk-link\" href=\"pdf-URL\" target=\"_blank\">Download as PDF ()</a></p>     \n                        <p class=\"govuk-body\"><a class=\"govuk-link\" href=\"/download/p--decision\" target=\"_blank\">Download as an accessible web page (HTML, )</a></p>                     \n                        <p class=\"govuk-body\"><a class=\"govuk-link\" href=\"javascript:window.print()\">Print your decision</a></p>                       \n                    </section>\n                    </article>\n                    <h3 class=\"govuk-heading-m govuk-!-margin-bottom-0\">More information</h3>\n                    <p class=\"govuk-body\"><a href=\"https://www.gov.uk/guidance/criminal-injuries-compensation-a-guide\" target=\"_blank\" class=\"govuk-link\">Read our guide to the Criminal Injuries Compensation Scheme<a>.</p>\n                    <h3 class=\"govuk-heading-m govuk-!-margin-bottom-0\">Contact us</h3>\n                    <p class=\"govuk-body\"><a href=\"https://contact-the-cica.form.service.justice.gov.uk/\" target=\"_blank\" class=\"govuk-link\">Contact us if you have any queries<a>.</p>\n                    "}},"options":{"hiddenButton":true,"showSurvey":"full","showBackButton":false}}},"p-do-you-have-supporting-info":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["q-supporting-info"],"additionalProperties":false,"properties":{"q-supporting-info":{"type":"boolean","title":"Do you have supporting information you want to send us?","description":"This could be any information you think is relevant. Do not send us anything you've sent us before.","oneOf":[{"title":"Yes","const":true},{"title":"No","const":false}],"meta":{"classifications":{"theme":"request-a-review"},"summary":{"title":"Do you have supporting information?"}}}},"errorMessage":{"required":{"q-supporting-info":"Do you have supporting information?"}},"options":{"showSurvey":"beta"}}},"p--check-your-answers":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,"properties":{"p-check-your-answers":{"title":"Confirm your answers","description":"Confirm your answers","type":"object","properties":{"summaryInfo":{"type":"object","urlPath":"apply","editAnswerText":"Change","summaryStructure":[],"lookup":{}}}}},"options":{"ordering":{},"buttonText":"Accept and send","showSurvey":"beta","pageContext":"submission"}}},"p--review-confirmation":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,"properties":{"confirmation":{"title":"Confirmation","description":"{{ govukPanel({\n                                  titleText: \"We've received your request\"\n                                })}}\n                                <p class=\"govuk-body\">Thank you for asking for a review.</p>\n                                <h3 class=\"govuk-heading-m\">Next steps</h2>\n                                <p class=\"govuk-body\">A different case officer will look at your application again to see if the decision was accurate.</p>\n                                <p class=\"govuk-body\">We make most review decisions within 6 months. Sometimes it can take longer depending on the circumstances of your claim.</p>\n                                <p class=\"govuk-body\">If you do not agree with the review decision, you can appeal to a tribunal. When we send you our review decision, we'll let you know how to do this.</p>\n                                <h3 class=\"govuk-heading-m\">Contact us</h2>\n                                <p class=\"govuk-body\"><a href=\"\" class=\"govuk-link\">Contact us if you have any queries<a>.</p>\n                                  "}},"options":{"showSurvey":"beta","showBackButton":false}}},"p--sending-supporting-information":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,"properties":{"context-sending-supporting-info":{"title":"Send supporting information","description":"\n                    <p class=\"govuk-body\">If you have information to support your review request, you must send it to us by post or email.</p>\n                    <p class=\"govuk-body\">It's fine to send us:</p>\n                    <ul class='govuk-list govuk-list--bullet'>\n                    <li>photocopies of documents</li>\n                    <li>scanned documents</li>\n                    <li>images of documents you have taken with a mobile phone</li>\n                    </ul>\n                    <p class=\"govuk-body\">It's better to send us copies of documents instead of the originals.</p>\n                    <p class=\"govuk-body\">You should include your CICA reference number on anything you send us. This is: ||/answers/system/case-reference||</p>\n                    <div class=\"govuk-inset-text\">\n                        <h2 class=\"govuk-heading-m\">Email</h2>\n                        <p class=\"govuk-body\"><a href=\"mailto:info@cica.gov.uk\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"govuk-link\">info@cica.gov.uk</a></p>\n                        <h2 class=\"govuk-heading-m\">Address</h2>\n                        <p class=\"govuk-body\">Criminal Injuries Compensation Authority\n                        <br>10 Clyde Place\n                        <br>Buchanan Wharf\n                        <br>Glasgow\n                        <br>G5 8AQ\n                        <br>United Kingdom</p>\n                    </div>\n                    "}},"meta":{"pageType":"context"},"options":{"showSurvey":"beta"}}},"p-why-do-you-want-a-review":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["q-why-do-you-want-a-review"],"properties":{"why-do-you-want-a-review-info":{"title":"Your reason for wanting a review","description":"<p class=\"govuk-body\">We need to know why you do not agree with our decision.</p>\n                        <p class=\"govuk-body\">In your request for a review, things you might want to include are:</p>\n                        <ul class='govuk-list govuk-list--bullet'>\n                        <li>if you do not think we’ve considered all the information you gave us</li>\n                        <li>if you think we’ve looked at the wrong information</li>\n                        <li>any new information you’d like to give us</li>\n                        <li>if you think our decision was wrong for another reason</li>\n                        </ul>\n                        <p class=\"govuk-body\">Do not include personal or financial information, like your National Insurance number or credit card details.</p>}"},"q-why-do-you-want-a-review":{"type":"string","title":"Tell us why you want a review","maxLength":10000,"errorMessage":{"maxLength":"Reasons must be 10000 characters or less"},"meta":{"classifications":{"theme":"request-a-review"},"summary":{"title":"Tell us why you want a review"}}}},"errorMessage":{"required":{"q-why-do-you-want-a-review":"Enter your reasons for wanting a review"}},"options":{"showSurvey":"beta","outputOrder":["why-do-you-want-a-review-info","q-why-do-you-want-a-review"],"properties":{"q-why-do-you-want-a-review":{"options":{"macroOptions":{"label":{"classes":"govuk-label--m"}}}}}}}},"p-deadline-for-review":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["q-reason-for-missing-review-deadline"],"additionalProperties":false,"properties":{"reason-for-missing-review-deadline-info":{"title":"Deadline for asking for a review","description":"\n                    <p class=\"govuk-body\">You missed the deadline to ask for a review. The deadline was ||/answers/system/expiry-date||.</p>\n                    <p class=\"govuk-body\">We can sometimes extend the time limit for reviews if there are exceptional circumstances.</p>\n                    <p class=\"govuk-body\">Before we look at your reason for wanting a review, we'll decide whether to extend the time limit or not. If we decide <b>not</b> to extend the time limit, we will not review your case.</p>\n                    <p class=\"govuk-body\"><b>We can only extend the time limit once.</b> If you've already asked for an extension and have missed the deadline, we cannot consider your request for a review.</p>\n                    "},"q-reason-for-missing-review-deadline":{"type":"string","title":"Tell us why you missed the deadline for asking for a review<","maxLength":10000,"errorMessage":{"maxLength":"Reasons must be 10000 characters or less"},"meta":{"classifications":{"theme":"request-a-review"}}}},"errorMessage":{"required":{"q-reason-for-missing-review-deadline":"Enter why you missed the deadline"}},"options":{"showSurvey":"beta","outputOrder":["reason-for-missing-review-deadline-info","q-reason-for-missing-review-deadline"],"properties":{"q-reason-for-missing-review-deadline":{"options":{"macroOptions":{"label":{"classes":"govuk-label--m"}}}}}}}},"system":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["case-reference"],"additionalProperties":false,"properties":{"case-reference":{"type":"string","pattern":"^[0-9]{2}\\\\[0-9]{6}$","errorMessage":{"pattern":"Invalid case reference"}}},"errorMessage":{"required":"Case reference is required"}}},"owner":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["owner-id","is-authenticated"],"properties":{"owner-id":{"type":"string","format":"uri","maxLength":64,"pattern":"^urn:(uuid|fdc:gov.uk:2022):"},"is-authenticated":{"type":"boolean"}},"errorMessage":{"required":{"owner-id":"Owner id is required","is-authenticated":"isAuthenticated is required"}}}},"origin":{"schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","required":["channel"],"properties":{"channel":{"type":"string","pattern":"^[a-z][a-z0-9]{0,19}(?:-[a-z0-9]{1,20}){0,20}$","errorMessage":{"pattern":"Channel is not a valid format"}}},"errorMessage":{"required":{"channel":"Channel is required"}}}}},"routes":{"initial":"p--decision","referrer":"https://www.gov.uk/claim-compensation-criminal-injury/make-claim","summary":["p--check-your-answers"],"confirmation":"p--review-confirmation","states":{"p--ask-for-a-review":{"on":{"ANSWER":[{"target":"p-deadline-for-review","cond":["|role.all","expired"]},{"target":"p-why-do-you-want-a-review"}]}},"p--decision":{"on":{"ANSWER":[{"target":"p--ask-for-a-review"}]}},"p-do-you-have-supporting-info":{"on":{"ANSWER":[{"target":"p--sending-supporting-information","cond":["==","$.answers.p-do-you-have-supporting-info.q-supporting-info",true]},{"target":"p--check-your-answers"}]}},"p--check-your-answers":{"on":{"ANSWER":[{"target":"p--review-confirmation"}]}},"p--review-confirmation":{"type":"final"},"p--sending-supporting-information":{"on":{"ANSWER":[{"target":"p--check-your-answers"}]}},"p-why-do-you-want-a-review":{"on":{"ANSWER":[{"target":"p-do-you-have-supporting-info"}]}},"p-deadline-for-review":{"on":{"ANSWER":[{"target":"p-why-do-you-want-a-review"}]}},"system":{"type":"final"},"owner":{"type":"final"},"origin":{"type":"final"}}},"answers":{},"onSubmit":{"id":"task0","type":"sequential","retries":0,"data":[{"id":"task1","type":"transformAndUpload","retries":0,"data":{"questionnaireDef":"$.questionnaireDef","logger":"$.logger"}},{"id":"task2","type":"sendSubmissionMessageToSQS","retries":0,"dat